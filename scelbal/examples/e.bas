10 DIM A(50)
20 FOR I=1 TO 50
30 A(I)=0
40 NEXT I
50 N=200
60 A(1)=A(1)+1
70 R=0
80 FOR I=1 TO 50
90 X=R*10000+A(I)
100 Q=INT(X/N)
110 B=Q*N
120 IF B+N>X THEN 130
122 Q=Q+1
124 B=B+N
130 IF B<=X THEN 150
140 Q=Q-1
145 B=B-N
150 R=X-B
160 A(I)=Q
170 NEXT I
180 N=N-1
190 IF N>0 THEN 60
200 A(1)=A(1)+1
210 C=0
220 FOR I=1 TO 50
230 V=A(I)
240 P=1000
250 IF I>1 THEN 270
260 P=1
270 J=INT(V/P)
275 B=J*P
280 IF B+P>V THEN 300
290 J=J+1
295 B=B+P
300 IF B<=V THEN 320
310 J=J-1
315 B=B-P
320 PRINT CHR(J+48);
330 C=C+1
340 IF C=192 THEN 400
350 V=V-B
360 P=P/10
370 IF P>=1 THEN 270
380 NEXT I
400 PRINT
410 PRINT "DONE"
420 END
RUN
