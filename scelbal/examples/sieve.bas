10 S=8190
20 DIM A(63)
30 FOR T=1 TO 10
40 C=0
50 L=0
60 H=L+62
70 IF H<=S THEN 90
80 H=S
90 B=2*H+3
91 F=2*L+3
92 E=H-L+1
95 FOR I=1 TO 63
100 A(I)=1
110 NEXT I
120 P=3
125 Q=P*P
130 IF Q>B THEN 280
140 K=INT(F/P)
150 IF K-2*INT(K/2)=1 THEN 170
160 K=K+1
170 K=(K*P-3)/2
180 IF K>=L THEN 200
190 K=K+P
200 Q=(Q-3)/2
210 IF K>=Q THEN 220
212 K=Q
220 IF K>H THEN 260
230 FOR K=K-L+1 TO E STEP P
240 A(K)=0
250 NEXT K
260 P=P+2
270 GOTO 125
280 FOR I=1 TO E
290 C=C+A(I)
300 NEXT I
310 L=H+1
320 IF L<=S THEN 60
330 NEXT T
340 X=C
342 GOSUB 500
344 PRINT " PRIMES"
350 X=T
352 GOSUB 500
354 PRINT " ITERATIONS"
360 END
500 D=10000
510 Z=0
520 J=INT(X/D)
525 B=J*D
530 IF B+D>X THEN 550
540 J=J+1
545 B=B+D
550 IF B<=X THEN 570
560 J=J-1
565 B=B-D
570 X=X-B
580 IF J>0 THEN 610
590 IF Z=1 THEN 610
600 IF D>1 THEN 630
610 PRINT CHR(J+48);
620 Z=1
630 D=D/10
640 IF D>=1 THEN 520
650 RETURN
RUN
