10 DIM BYTE A(8190)
20 FOR T=1 TO 10
30 FOR I=0 TO 8190
40 A(I)=1
50 NEXT I
60 C=0
70 FOR I=0 TO 8190
80 IF A(I)=0 THEN 160
90 P=I+I+3
100 K=I+P
110 IF K>8190 THEN 150
120 FOR K=K TO 8190 STEP P
130 A(K)=0
140 NEXT K
150 C=C+1
160 NEXT I
170 NEXT T
180 PRINT C;" PRIMES"
190 PRINT "10 ITERATIONS"
200 END
RUN
