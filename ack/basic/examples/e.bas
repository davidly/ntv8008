10 DEFINT A-Z
20 REM Decimal spigot, 192 digits from 200 working cells.
30 DIM A(199)
40 FOR N=2 TO 199:A(N)=1:NEXT N
50 A(0)=0:A(1)=2:X=0:H=200
60 WHILE H>9
70 H=H-1:N=H
80 WHILE N<>0
90 A(N)=X MOD N
100 X=10*A(N-1)+X\N:N=N-1
110 WEND
120 IF X>=10 THEN PRINT CHR$(48+X\10);
130 PRINT CHR$(48+X MOD 10);
140 WEND
150 PRINT:PRINT "done."
160 END
