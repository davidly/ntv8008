10 DEFINT A-Z
20 REM Segmented odd-number sieve with 8191 candidates, ten passes.
30 DIM A(1023)
40 FOR T=1 TO 10
50 C=0:L=0
60 H=L+1023:IF H>8190 THEN H=8190
70 F=2*L+3:B=2*H+3:E=H-L
80 FOR I=0 TO E:A(I)=1:NEXT I
90 P=3
100 Q=P*P:IF Q>B THEN 200
110 K=F\P:IF K MOD 2=0 THEN K=K+1
120 K=(K*P-3)\2:IF K<L THEN K=K+P
130 Q=(Q-3)\2:IF K<Q THEN K=Q
140 IF K>H THEN 180
150 FOR J=K-L TO E STEP P:A(J)=0:NEXT J
180 P=P+2:GOTO 100
200 FOR I=0 TO E:C=C+A(I):NEXT I
210 L=H+1:IF L<=8190 THEN 60
220 NEXT T
230 U=C:GOSUB 8000:PRINT " primes."
240 END
8000 D=10000:Z=0
8010 J=U\D:U=U-J*D
8020 IF J<>0 THEN 8050
8030 IF Z<>0 THEN 8050
8040 IF D<>1 THEN 8060
8050 PRINT CHR$(J+48);:Z=1
8060 D=D\10:IF D<>0 THEN 8010
8070 RETURN
