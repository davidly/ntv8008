10 REM Rooms 0 hall, 1 cellar with key, 2 locked exit
20 DIM BYTE N(2),S(2)
30 N(0)=2:N(1)=0:N(2)=2
40 S(0)=1:S(1)=1:S(2)=0
50 R=0:K=0
60 PRINT "THE THREE-ROOM ESCAPE"
70 PRINT "1 NORTH, 2 SOUTH, 3 TAKE, 4 OPEN, 0 QUIT"
100 IF R=0 THEN PRINT "HALL"
110 IF R=1 THEN PRINT "CELLAR"
120 IF R=2 THEN PRINT "LOCKED DOOR"
130 INPUT C
140 IF C=0 THEN 500
150 IF C=1 THEN R=N(R):GOTO 100
160 IF C=2 THEN R=S(R):GOTO 100
170 IF C=3 THEN 300
180 IF C=4 THEN 400
190 PRINT "USE 0 TO 4":GOTO 100
300 IF R<>1 THEN PRINT "NOTHING TO TAKE":GOTO 100
310 K=1:PRINT "KEY TAKEN":GOTO 100
400 IF R<>2 THEN 430
410 IF K=0 THEN 430
420 PRINT "YOU ESCAPED!":END
430 PRINT "YOU NEED THE KEY AT THE DOOR":GOTO 100
500 PRINT "GOODBYE":END
RUN
